# No pongas secretos aquí. Copia a `.env` y completa.
# DATABASE_URL debe usar el host `postgres` dentro de Docker.
# API_URL interno: http://backend:3000
# VITE_API_URL público del browser, p.ej. http://api.localhost

POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
DATABASE_URL=
JWT_SECRET=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
PAYMENT_PROVIDER=
PAYMENT_CURRENCY=
CULQI_SECRET_KEY=
MERCADOPAGO_ACCESS_TOKEN=
API_URL=
VITE_API_URL=
# Llave pública de Culqi para el storefront (checkout con tarjeta en el
# navegador). Vacía = el checkout muestra "Pago no disponible".
NEXT_PUBLIC_PAYMENT_PROVIDER=
NEXT_PUBLIC_CULQI_PUBLIC_KEY=
NEXT_PUBLIC_PAYMENT_CURRENCY=
COOKIE_SECURE=
STOREFRONT_HOST=
ADMIN_HOST=
API_HOST=
CERTBOT_EMAIL=
SSL_CERT_NAME=
